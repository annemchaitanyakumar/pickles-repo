import React, { useState, useEffect } from 'react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import {
    Select,
    SelectContent,
    SelectItem,
    SelectTrigger,
    SelectValue,
} from '@/components/ui/select';
import { Textarea } from '@/components/ui/textarea';
import { useToast } from '@/hooks/use-toast';
import { useNavigate } from 'react-router-dom';
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { ScrollArea } from "@/components/ui/scroll-area";
import { Badge } from "@/components/ui/badge";
import { motion, AnimatePresence } from "framer-motion";
import { FileUploader } from "react-drag-drop-files";
import { 
    Package2, 
    ImagePlus,
    Tags,
    ClipboardList,
    Loader2
} from "lucide-react";

const fileTypes = ["JPG", "PNG", "WEBP"];

export const AddProductForm = ({ onSuccess }) => {
    const { toast } = useToast();
    const navigate = useNavigate();
    const [loading, setLoading] = useState(false);
    const [activeTab, setActiveTab] = useState("basic");
    const [imageFiles, setImageFiles] = useState({
        product_image1: null,
        product_image2: null,
        product_image3: null
    });
    const [imagePreviews, setImagePreviews] = useState({
        product_image1: null,
        product_image2: null,
        product_image3: null
    });

    const [formData, setFormData] = useState({
        category: '',
        product_name: '',
        product_title: '',
        product_description: '',
        variants: [
            { weight: '', price: '', stock: '' }
        ]
    });

    // Admin check
    useEffect(() => {
        const authData = localStorage.getItem('authData');
        
        if (authData) {
            const parsedAuthData = JSON.parse(authData);
            
            if (parsedAuthData.role !== 'ROLE_ADMIN') {
                toast({
                    variant: "destructive",
                    title: "Access Denied",
                    description: "Only administrators can add products"
                });
                navigate('/');
                return;
            }

            const token = parsedAuthData.token || parsedAuthData.accessToken;
            if (!token) {
                toast({
                    variant: "destructive",
                    title: "Authentication Error",
                    description: "Please login again"
                });
                navigate('/login');
                return;
            }
        } else {
            toast({
                variant: "destructive",
                title: "Access Denied",
                description: "Please login as administrator"
            });
            navigate('/login');
        }
    }, [navigate, toast]);

    const handleInputChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: value }));
    };

    const handleImageChange = (file, imageNumber) => {
        const imageKey = `product_image${imageNumber}`;
        setImageFiles(prev => ({
            ...prev,
            [imageKey]: file
        }));
        
        // Create preview URL
        const reader = new FileReader();
        reader.onloadend = () => {
            setImagePreviews(prev => ({
                ...prev,
                [imageKey]: reader.result
            }));
        };
        reader.readAsDataURL(file);
    };

    const handleVariantChange = (index, field, value) => {
        setFormData(prev => ({
            ...prev,
            variants: prev.variants.map((v, i) =>
                i === index ? { ...v, [field]: value } : v
            )
        }));
    };

    const addVariant = () => {
        setFormData(prev => ({
            ...prev,
            variants: [...prev.variants, { weight: '', price: '', stock: '' }]
        }));
    };

    const removeVariant = (index) => {
        setFormData(prev => ({
            ...prev,
            variants: prev.variants.filter((_, i) => i !== index)
        }));
    };

    // Helper function to get the stored auth token
    const getStoredAuthToken = () => {
        try {
            const authDataStr = localStorage.getItem('authData');
            if (!authDataStr) return null;
            
            const authData = JSON.parse(authDataStr);
            const token = authData.accessToken || authData.token || localStorage.getItem('auth_token');

            return token.startsWith('Bearer ') ? token.split(' ')[1] : token;
        } catch (error) {
            console.error('Error getting auth token:', error);
            return null;
        }
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        setLoading(true);

        try {
            const authDataStr = localStorage.getItem('authData');
            if (!authDataStr) throw new Error('Authentication required');

            const authData = JSON.parse(authDataStr);
            const role = authData.role?.replace("ROLE_", "") || null;
            if (role !== "ADMIN") {
                throw new Error('Only administrators can add products');
            }

            const token = getStoredAuthToken();
            if (!token) throw new Error('No token found');
            
            if (!formData.category) throw new Error('Please select a category');
            if (!formData.product_title) throw new Error('Product title is required');
            if (!imageFiles.product_image1) throw new Error('At least one image is required');

            const variants = formData.variants
                .filter(v => v.weight && v.price && v.stock)
                .map((v, index) => ({
                    variant_id: index + 1,
                    weight: String(v.weight),
                    price: String(v.price),
                    stock: String(v.stock)
                }));

            const payload = {
                product_name: String(formData.product_name || formData.product_title).trim(),
                product_title: String(formData.product_title).trim(),
                product_description: String(formData.product_description).trim(),
                category: String(formData.category).trim(),
                variants: variants
            };

            const formDataToSend = new FormData();
            formDataToSend.append('product_name', payload.product_name);
            formDataToSend.append('product_title', payload.product_title);
            formDataToSend.append('product_description', payload.product_description);
            formDataToSend.append('category', payload.category);
            formDataToSend.append('variants', JSON.stringify(payload.variants));

            // Append images
            Object.entries(imageFiles).forEach(([key, file]) => {
                if (file) formDataToSend.append(key, file);
            });

            const apiUrl = `${import.meta.env.VITE_DJANGO_URL}/products/`;
            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                },
                body: formDataToSend
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.message || 'Failed to add product');
            }

            toast({
                title: "Success!",
                description: "Product added successfully",
            });

            if (onSuccess) {
                onSuccess();
            }

        } catch (error) {
            console.error('Error adding product:', error);
            toast({
                variant: "destructive",
                title: "Error",
                description: error.message || "Failed to add product"
            });
        } finally {
            setLoading(false);
        }
    };

    return (
        <form onSubmit={handleSubmit} className="max-w-4xl mx-auto p-6">
            <Card className="border-2 shadow-lg">
                <CardHeader>
                    <CardTitle className="text-2xl font-bold gradient-primary bg-clip-text text-transparent">
                        Add New Product
                    </CardTitle>
                    <CardDescription>
                        Create a new product with details, images, and variants.
                    </CardDescription>
                </CardHeader>
                <CardContent>
                    <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full">
                        <TabsList className="grid w-full grid-cols-4 mb-8">
                            <TabsTrigger value="basic" className="flex items-center gap-2">
                                <Package2 className="w-4 h-4" />
                                Basic Info
                            </TabsTrigger>
                            <TabsTrigger value="images" className="flex items-center gap-2">
                                <ImagePlus className="w-4 h-4" />
                                Images
                            </TabsTrigger>
                            <TabsTrigger value="variants" className="flex items-center gap-2">
                                <Tags className="w-4 h-4" />
                                Variants
                            </TabsTrigger>
                            <TabsTrigger value="review" className="flex items-center gap-2">
                                <ClipboardList className="w-4 h-4" />
                                Review
                            </TabsTrigger>
                        </TabsList>

                        <div className="mt-6">
                            <AnimatePresence mode="wait">
                                <TabsContent key="basic" value="basic" className="space-y-6">
                                    <motion.div
                                        initial={{ opacity: 0, y: 20 }}
                                        animate={{ opacity: 1, y: 0 }}
                                        exit={{ opacity: 0, y: -20 }}
                                        transition={{ duration: 0.3 }}
                                    >
                                        <div className="space-y-6">
                                            <div className="grid gap-6">
                                                <div className="space-y-2">
                                                    <Label htmlFor="category">Category</Label>
                                                    <Select
                                                        name="category"
                                                        value={formData.category}
                                                        onValueChange={(value) => setFormData(prev => ({ ...prev, category: value }))}
                                                    >
                                                        <SelectTrigger className="w-full">
                                                            <SelectValue placeholder="Select category" />
                                                        </SelectTrigger>
                                                        <SelectContent>
                                                            <SelectItem value="fermented">Fermented Pickles</SelectItem>
                                                            <SelectItem value="vinegar">Vinegar Based Pickles</SelectItem>
                                                            <SelectItem value="oil">Oil Based Pickles</SelectItem>
                                                            <SelectItem value="specialty">Specialty Pickles</SelectItem>
                                                            <SelectItem value="seasonal">Seasonal Specialties</SelectItem>
                                                        </SelectContent>
                                                    </Select>
                                                </div>
                                                
                                                <div className="space-y-2">
                                                    <Label htmlFor="product_title">Product Title</Label>
                                                    <Input
                                                        type="text"
                                                        name="product_title"
                                                        value={formData.product_title}
                                                        onChange={handleInputChange}
                                                        placeholder="Customer-facing product name"
                                                        className="w-full"
                                                    />
                                                </div>

                                                <div className="space-y-2">
                                                    <Label htmlFor="product_name">Internal Reference Name</Label>
                                                    <Input
                                                        type="text"
                                                        name="product_name"
                                                        value={formData.product_name}
                                                        onChange={handleInputChange}
                                                        placeholder="Internal reference name"
                                                        className="w-full"
                                                    />
                                                </div>

                                                <div className="space-y-2">
                                                    <Label htmlFor="product_description">Description</Label>
                                                    <Textarea
                                                        name="product_description"
                                                        value={formData.product_description}
                                                        onChange={handleInputChange}
                                                        placeholder="Tell customers about your product..."
                                                        className="min-h-[150px]"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                    </motion.div>
                                </TabsContent>

                                <TabsContent key="images" value="images">
                                    <motion.div
                                        initial={{ opacity: 0, y: 20 }}
                                        animate={{ opacity: 1, y: 0 }}
                                        exit={{ opacity: 0, y: -20 }}
                                        transition={{ duration: 0.3 }}
                                        className="grid gap-6 md:grid-cols-3"
                                    >
                                        {[1, 2, 3].map((num) => (
                                            <Card key={num} className="overflow-hidden">
                                                <CardHeader className="p-4">
                                                    <CardTitle className="text-sm">Image {num}</CardTitle>
                                                </CardHeader>
                                                <CardContent className="p-4 pt-0">
                                                    <div className="aspect-square rounded-lg border-2 border-dashed relative">
                                                        {imagePreviews[`product_image${num}`] ? (
                                                            <div className="absolute inset-0">
                                                                <img 
                                                                    src={imagePreviews[`product_image${num}`]} 
                                                                    alt={`Preview ${num}`}
                                                                    className="w-full h-full object-cover rounded-lg"
                                                                />
                                                                <Button
                                                                    type="button"
                                                                    variant="destructive"
                                                                    size="sm"
                                                                    className="absolute top-2 right-2"
                                                                    onClick={() => {
                                                                        setImageFiles(prev => ({ ...prev, [`product_image${num}`]: null }));
                                                                        setImagePreviews(prev => ({ ...prev, [`product_image${num}`]: null }));
                                                                    }}
                                                                >
                                                                    Remove
                                                                </Button>
                                                            </div>
                                                        ) : (
                                                            <FileUploader
                                                                handleChange={(file) => handleImageChange(file, num)}
                                                                name={`product_image${num}`}
                                                                types={fileTypes}
                                                                classes="w-full h-full flex items-center justify-center"
                                                            >
                                                                <div className="text-center p-4">
                                                                    <ImagePlus className="w-8 h-8 mx-auto mb-2 text-muted-foreground" />
                                                                    <p className="text-sm text-muted-foreground">
                                                                        Drop image here or click to upload
                                                                    </p>
                                                                </div>
                                                            </FileUploader>
                                                        )}
                                                    </div>
                                                </CardContent>
                                            </Card>
                                        ))}
                                    </motion.div>
                                </TabsContent>

                                <TabsContent key="variants" value="variants">
                                    <motion.div
                                        initial={{ opacity: 0, y: 20 }}
                                        animate={{ opacity: 1, y: 0 }}
                                        exit={{ opacity: 0, y: -20 }}
                                        transition={{ duration: 0.3 }}
                                    >
                                        <ScrollArea className="h-[500px] pr-4">
                                            <div className="space-y-4">
                                                {formData.variants.map((variant, index) => (
                                                    <Card key={index} className="relative">
                                                        <CardHeader className="pb-4">
                                                            <div className="flex justify-between items-center">
                                                                <CardTitle className="text-lg">
                                                                    Variant {index + 1}
                                                                </CardTitle>
                                                                {formData.variants.length > 1 && (
                                                                    <Button
                                                                        type="button"
                                                                        variant="destructive"
                                                                        size="sm"
                                                                        onClick={() => removeVariant(index)}
                                                                    >
                                                                        Remove
                                                                    </Button>
                                                                )}
                                                            </div>
                                                        </CardHeader>
                                                        <CardContent className="grid gap-4 sm:grid-cols-3">
                                                            <div className="space-y-2">
                                                                <Label htmlFor={`weight-${index}`}>Weight</Label>
                                                                <Input
                                                                    type="text"
                                                                    id={`weight-${index}`}
                                                                    value={variant.weight}
                                                                    onChange={(e) => handleVariantChange(index, 'weight', e.target.value)}
                                                                    placeholder="e.g., 250g"
                                                                />
                                                            </div>
                                                            <div className="space-y-2">
                                                                <Label htmlFor={`price-${index}`}>Price</Label>
                                                                <Input
                                                                    type="number"
                                                                    id={`price-${index}`}
                                                                    value={variant.price}
                                                                    onChange={(e) => handleVariantChange(index, 'price', e.target.value)}
                                                                    placeholder="e.g., 199"
                                                                />
                                                            </div>
                                                            <div className="space-y-2">
                                                                <Label htmlFor={`stock-${index}`}>Stock</Label>
                                                                <Input
                                                                    type="number"
                                                                    id={`stock-${index}`}
                                                                    value={variant.stock}
                                                                    onChange={(e) => handleVariantChange(index, 'stock', e.target.value)}
                                                                    placeholder="e.g., 100"
                                                                />
                                                            </div>
                                                        </CardContent>
                                                    </Card>
                                                ))}
                                            </div>
                                        </ScrollArea>

                                        <Button
                                            type="button"
                                            onClick={addVariant}
                                            className="mt-4 w-full"
                                            variant="outline"
                                        >
                                            Add Another Variant
                                        </Button>
                                    </motion.div>
                                </TabsContent>

                                <TabsContent key="review" value="review">
                                    <motion.div
                                        initial={{ opacity: 0, y: 20 }}
                                        animate={{ opacity: 1, y: 0 }}
                                        exit={{ opacity: 0, y: -20 }}
                                        transition={{ duration: 0.3 }}
                                    >
                                        <Card>
                                            <CardHeader>
                                                <CardTitle>Product Summary</CardTitle>
                                                <CardDescription>Review your product details before submission</CardDescription>
                                            </CardHeader>
                                            <CardContent className="space-y-6">
                                                <div className="space-y-2">
                                                    <h3 className="font-medium">Basic Information</h3>
                                                    <div className="grid gap-2">
                                                        <div className="flex justify-between py-1 border-b">
                                                            <span className="text-muted-foreground">Category:</span>
                                                            <Badge variant="outline">{formData.category || 'Not set'}</Badge>
                                                        </div>
                                                        <div className="flex justify-between py-1 border-b">
                                                            <span className="text-muted-foreground">Title:</span>
                                                            <span className="font-medium">{formData.product_title || 'Not set'}</span>
                                                        </div>
                                                        <div className="flex justify-between py-1 border-b">
                                                            <span className="text-muted-foreground">Reference Name:</span>
                                                            <span>{formData.product_name || 'Not set'}</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="space-y-2">
                                                    <h3 className="font-medium">Images</h3>
                                                    <div className="grid grid-cols-3 gap-4">
                                                        {[1, 2, 3].map((num) => (
                                                            <div key={num} className="aspect-square rounded-lg border bg-muted relative">
                                                                {imagePreviews[`product_image${num}`] ? (
                                                                    <img 
                                                                        src={imagePreviews[`product_image${num}`]}
                                                                        alt={`Preview ${num}`}
                                                                        className="w-full h-full object-cover rounded-lg"
                                                                    />
                                                                ) : (
                                                                    <div className="flex items-center justify-center h-full">
                                                                        <span className="text-sm text-muted-foreground">No image</span>
                                                                    </div>
                                                                )}
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>

                                                <div className="space-y-2">
                                                    <h3 className="font-medium">Variants ({formData.variants.length})</h3>
                                                    <div className="grid gap-2">
                                                        {formData.variants.map((variant, index) => (
                                                            <div key={index} className="p-2 border rounded-lg">
                                                                <div className="grid grid-cols-3 gap-4">
                                                                    <div className="text-sm">
                                                                        <span className="text-muted-foreground">Weight:</span>{' '}
                                                                        {variant.weight || 'Not set'}
                                                                    </div>
                                                                    <div className="text-sm">
                                                                        <span className="text-muted-foreground">Price:</span>{' '}
                                                                        {variant.price || 'Not set'}
                                                                    </div>
                                                                    <div className="text-sm">
                                                                        <span className="text-muted-foreground">Stock:</span>{' '}
                                                                        {variant.stock || 'Not set'}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </CardContent>
                                        </Card>
                                    </motion.div>
                                </TabsContent>
                            </AnimatePresence>
                        </div>
                    </Tabs>
                </CardContent>
                <CardFooter className="flex justify-between">
                    <Button
                        type="button"
                        variant="outline"
                        onClick={() => {
                            const tabs = ['basic', 'images', 'variants', 'review'];
                            const currentIndex = tabs.indexOf(activeTab);
                            if (currentIndex > 0) {
                                setActiveTab(tabs[currentIndex - 1]);
                            }
                        }}
                        disabled={activeTab === 'basic'}
                    >
                        Previous
                    </Button>

                    {activeTab === 'review' ? (
                        <Button
                            type="submit"
                            disabled={loading}
                            className="bg-gradient-to-r from-secondary to-primary text-primary-foreground hover:opacity-90"
                        >
                            {loading ? (
                                <>
                                    <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                                    Adding Product...
                                </>
                            ) : (
                                'Add Product'
                            )}
                        </Button>
                    ) : (
                        <Button
                            type="button"
                            onClick={() => {
                                const tabs = ['basic', 'images', 'variants', 'review'];
                                const currentIndex = tabs.indexOf(activeTab);
                                if (currentIndex < tabs.length - 1) {
                                    setActiveTab(tabs[currentIndex + 1]);
                                }
                            }}
                        >
                            Next
                        </Button>
                    )}
                </CardFooter>
            </Card>
        </form>
    );
};